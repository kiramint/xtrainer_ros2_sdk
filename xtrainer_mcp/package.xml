<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>xtrainer_mcp</name>
  <version>0.1.0</version>
  <description>XTrainer MCP 服务。一键拉起驱动和 move_group，agent 再通过 stdio 调用相机、规划和夹爪。</description>
  <maintainer email="kira@todo.todo">kira</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>xtrainer_control</exec_depend>
  <exec_depend>xtrainer_moveit</exec_depend>
  <exec_depend>xtrainer_gripper</exec_depend>
  <exec_depend>xtrainer_description</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>dobot_msgs_v4</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
